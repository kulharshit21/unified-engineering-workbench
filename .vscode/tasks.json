{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Workbench (Release)",
      "type": "shell",
      "command": "powershell.exe -ExecutionPolicy Bypass -File ${workspaceFolder}/scripts/build.ps1 -Config Release",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run Tests (CTest)",
      "type": "shell",
      "command": "powershell.exe -ExecutionPolicy Bypass -File ${workspaceFolder}/scripts/test.ps1 -Config Release",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Package Standalone Distribution",
      "type": "shell",
      "command": "powershell.exe -ExecutionPolicy Bypass -File ${workspaceFolder}/scripts/package.ps1",
      "problemMatcher": []
    }
  ]
}
